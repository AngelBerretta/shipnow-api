{
  "name": "ruvika",
  "version": "0.1.0",
  "description": "Ruvika - plataforma de gestion logistica (monorepo: API, paneles y apps)",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @ruvika/api",
    "start": "npm run start -w @ruvika/api",
    "test": "npm test --workspaces --if-present",
    "test:api": "npm test -w @ruvika/api",
    "test:shared": "npm test -w @ruvika/shared",
    "lint": "eslint .",
    "seed:admin": "npm run seed:admin -w @ruvika/api",
    "migrate:stage0": "npm run migrate:stage0 -w @ruvika/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0"
  },
  "license": "MIT"
}
