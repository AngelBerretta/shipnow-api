PORT=3000
MONGODB_URI=mongodb://localhost:27017/ruvika
NODE_ENV=production
LOG_LEVEL=info
BCRYPT_ROUNDS=10
CORS_ORIGIN=https://tu-dominio-real.com
EMAIL_SERVICE_URL=
ENABLE_INTERNAL_ROUTES=false
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
AUTH_RATE_LIMIT_MAX=20
TRUST_PROXY=1
# --- Archivos subidos (Etapa 3) ----------------------------------------
# Sin estas 4 variables se usa el disco local (uploads/). En Render, que tiene
# disco efimero, hay que definirlas: los comprobantes se guardan en Cloudflare R2.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=ruvika-uploads
