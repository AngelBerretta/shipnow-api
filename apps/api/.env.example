# Copia este archivo como .env (dentro de apps/api) y completa los valores reales.
# El archivo .env NUNCA debe subirse al repositorio.

# Puerto donde se levanta el servidor HTTP
PORT=3000

# Cadena de conexion a MongoDB
MONGODB_URI=mongodb://localhost:27017/ruvika

# Entorno de ejecucion: development | production | test
NODE_ENV=development

# --- Opcionales -------------------------------------------------------

# Costo (rounds) de bcrypt para hashear contrasenas. Entero entre 4 y 15.
# Default: 10 (en tests se usa 4 automaticamente).
# BCRYPT_ROUNDS=10

# --- Solo para `npm run seed:admin` (primer administrador) ------------
# La API no lee estas variables; las usa unicamente el script. No hay
# credenciales por defecto: sin ADMIN_EMAIL y ADMIN_PASSWORD el script no corre.
# ADMIN_EMAIL=admin@ruvika.com
# ADMIN_PASSWORD=cambia-esta-clave
# ADMIN_FIRST_NAME=Admin
# ADMIN_LAST_NAME=Ruvika

# --- Autenticación (Etapa 1) -------------------------------------------
# OBLIGATORIA, mínimo 32 caracteres. Generala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7
# AUTH_RATE_LIMIT_MAX=20      # intentos por IP cada 15 min en /api/auth/*
# TRUST_PROXY=1               # cantidad de proxies delante (Render = 1)

# --- Archivos subidos (Etapa 3) ----------------------------------------
# Sin estas 4 variables se usa el disco local (uploads/). En Render, que tiene
# disco efimero, hay que definirlas: los comprobantes se guardan en Cloudflare R2.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=ruvika-uploads

# --- Seguimiento público (Etapa 4) --------------------------------------
# TRACKING_RATE_LIMIT_MAX=120   # consultas por IP cada 15 min
# TRACKING_MISS_LIMIT_MAX=20    # consultas fallidas (código inexistente) por IP cada 15 min

# --- Notificaciones y reportes (Etapa 5) --------------------------------
# Todo opcional: un canal sin configurar simplemente no se usa.
# RESEND_API_KEY=
# EMAIL_FROM="Ruvika <onboarding@resend.dev>"
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@ruvika.com
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=
# TRACKING_URL=https://tu-portal.pages.dev
# ADMIN_URL=https://tu-panel.pages.dev
# INTERNAL_API_SECRET=      # mínimo 32 caracteres; lo usa GitHub Actions
# NOTIFICATION_MAX_ATTEMPTS=5
