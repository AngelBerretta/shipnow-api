# Copia este archivo como .env.test y completa los valores para tu entorno
# de testing. El archivo .env.test NUNCA debe subirse al repositorio.
#
# La suite de tests (Mocha + Chai + Supertest) carga estas variables en vez
# de las de .env: ver test/setup.js.

# No se usa realmente en los tests (Supertest importa la app directamente,
# sin levantar el servidor con app.listen), pero se mantiene porque
# env.config.js la exige igual que a las demas.
PORT=3001

# Base de datos EXCLUSIVA para testing. Debe ser DISTINTA a la de
# desarrollo/produccion: los tests la limpian por completo despues de cada
# test individual (ver afterEach en test/setup.js), asi que cualquier dato
# que tenga se pierde.
MONGODB_URI=mongodb://localhost:27017/shipnow_test

# Fija el nivel de logs en "warning" (ver src/config/logger.config.js) y
# hace que la app trate este entorno como testing, no como desarrollo.
NODE_ENV=test
