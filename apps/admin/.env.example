# URL base de la API. Vacio = mismo origen (en dev, Vite hace proxy de /api a localhost:3000).
# En produccion (Cloudflare Pages): https://tu-api.onrender.com
VITE_API_URL=

# URL pública del portal de seguimiento (apps/tracking). Vacío = no se muestra el enlace en el detalle del pedido.
VITE_TRACKING_URL=

# URL de la API para el WebSocket del mapa en vivo. Vacío = mismo origen (en dev, Vite hace proxy).
# En producción: https://tu-api.onrender.com  (y CORS_ORIGIN en la API con el dominio del panel)
VITE_SOCKET_URL=
